# Cloud Run: suffai-similarity (Pub/Sub push + admin APIs)
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PORT=8080 \
    ENABLE_VERTEX=true \
    USE_BQ=true \
    BQ_DATASET=suffai_ops \
    SIMILARITY_THRESHOLD=0.92

WORKDIR /app

COPY requirements-similarity.txt .
RUN pip install --no-cache-dir -r requirements-similarity.txt

COPY similarity ./similarity

EXPOSE 8080
CMD exec uvicorn similarity.main:app --host 0.0.0.0 --port ${PORT}
