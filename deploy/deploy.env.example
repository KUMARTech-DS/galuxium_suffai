# OPTIONAL overrides for deploy/deploy_all.sh. Not needed: the script runs with only a project ID
#   ./deploy/deploy_all.sh my-project-id
# and every value below is its built-in default. To change some, copy this file, keep only the
# lines you change, and pass it in:
#   cp deploy/deploy.env.example deploy/deploy.env
#   ./deploy/deploy_all.sh my-project-id --env-file deploy/deploy.env
# Exported shell variables win over this file; command-line options win over both.

# --- Project -------------------------------------------------------------------------------
# Usually given as the script's first argument instead.
GOOGLE_CLOUD_PROJECT=your-project-id
GCP_REGION=asia-south1
# true = create the project if it doesn't exist yet.
CREATE_PROJECT=false
PROJECT_NAME=
# Linked when billing is off (always needed for a new project). List yours: gcloud billing accounts list
BILLING_ACCOUNT=
# Where to create a new project: set one of these if your account belongs to an organization.
ORG_ID=
FOLDER_ID=

# --- Build ---------------------------------------------------------------------------------
# cloudbuild: build on Google Cloud (no local Docker needed). docker: build locally and push.
BUILD_MODE=cloudbuild
# Image tag; empty = timestamp, so every run deploys exactly the images it built.
IMAGE_TAG=

# --- Storage -------------------------------------------------------------------------------
GCS_IMAGE_BUCKET=            # empty = <project>-suffai-garment-images
GCS_RAW_BUCKET=              # empty = <project>-cmd-center-raw (CSV staging for BigQuery loads)

# --- Cloud SQL (PostgreSQL) ----------------------------------------------------------------
SQL_INSTANCE=suffai-ops
SQL_DATABASE=suffai
SQL_USER=suffai
SQL_TIER=db-g1-small
SQL_VERSION=POSTGRES_15
# Leave empty: a random password is generated on first run and kept in Secret Manager
# (suffai-db-password). Set it only to reuse an existing user's password.
DB_PASSWORD=

# --- BigQuery ------------------------------------------------------------------------------
BQ_DATASET=suffai_ops
# Load command_center_data/sample/*.csv into empty tables. Never overwrites a table with rows
# unless FORCE_SAMPLE_DATA=true.
LOAD_SAMPLE_DATA=true
FORCE_SAMPLE_DATA=false
# Generate + load role logins (login_cred_db) when the table is empty. FORCE_LOGINS=true reloads.
LOAD_LOGINS=true
FORCE_LOGINS=false
# Also create suffai_raw / suffai_staging / suffai_marts (analytics/bigquery).
BQ_ANALYTICS=true
# Rebuild web/metrics.json from BigQuery before the image build (Command Center chat summary).
REFRESH_METRICS=false

# --- Services ------------------------------------------------------------------------------
ENABLE_VERTEX=true
VERTEX_LOCATION=asia-south1
VERTEX_CHAT_MODEL=gemini-2.5-flash
EXTRACTION_MODEL=gemini-2.0-flash
VERTEX_EMBED_MODEL=multimodalembedding@001
EMBED_DIMENSION=1408
SIMILARITY_THRESHOLD=0.92
# Customer photo -> warehouse catalog photo (style x colour, size ignored). A match needs exactly one
# style at or above this similarity; its catalog details then replace what Gemini read (size stays).
CATALOG_MATCH_THRESHOLD=0.92
# Catalog photos fingerprinted per customer photo until a brand's whole catalog has fingerprints.
CATALOG_EMBED_PER_REQUEST=40
# City used to resolve PIN codes to area names (Geo, Admin).
GEO_CITY=Bengaluru
# Look up every customer PIN with Gemini during the bigquery step (slow; Geo also does it on demand).
BACKFILL_PIN_AREAS=false
# Legacy FastAPI (customer upload initiate/complete). Off by default; Command Center replaces it.
DEPLOY_API=false

# --- Pub/Sub -------------------------------------------------------------------------------
PUBSUB_IMAGE_TOPIC=garment-image-uploaded
PUBSUB_EXTRACTED_TOPIC=garment-image-extracted
# Fire extraction when a customer photo lands in the bucket under this prefix
# (garments/<customer_id>_<order_id>_<item_id>.jpg). Turn off only if uploads go through the
# legacy API, which publishes itself; otherwise each photo is processed twice.
ENABLE_GCS_NOTIFICATION=true
GCS_NOTIFICATION_PREFIX=garments/

# --- Campaign jobs -------------------------------------------------------------------------
# Run Ads Lab ranking jobs on Cloud Tasks instead of a thread inside Command Center.
ENABLE_CLOUD_TASKS=false

# --- 1P platform fee (cost policy, priced separately from media spend) ---------------------
FEE_MODEL_VERSION=cost_model_v1
FEE_BASE_INR=1500
FEE_PER_1K_AUDIENCE=35
FEE_PER_SKU_INR=125
FEE_PER_PIN_INR=45
FEE_PER_10K_COMPARISONS_INR=20
FEE_PER_PROCESS_MINUTE_INR=12
FEE_PER_EXTRA_CHANNEL_INR=250
FEE_PER_DAY_INR=10
FEE_MIN_INR=1500
FEE_MAX_PCT_OF_BUDGET=0.35
# Keep false until 500-1,000 real accepted fees exist. Shadow predictions never set the price.
FEE_VERTEX_SHADOW=false
VERTEX_FEE_ENDPOINT_ID=
# Daily export of aggregate fee features to BigQuery (Cloud Run Job + Cloud Scheduler).
ENABLE_FEE_FEATURES_JOB=true
FEE_FEATURES_SCHEDULE=45 2 * * *
SCHEDULER_TIME_ZONE=Asia/Kolkata
