# Copy to .env for local API (never commit secrets)
ENVIRONMENT=local
PORT=8080
WEB_ORIGIN=http://localhost:3000,http://localhost:8081
API_PUBLIC_URL=http://localhost:8080
NEXT_PUBLIC_API_URL=http://localhost:8080

DATA_DIR=./data_offline
DERIVED_DIR=./data_derived
DEMO_AUTH_ENABLED=true
JWT_SECRET=replace-me

# Identity Platform (Firebase Auth) — prod
IDENTITY_PLATFORM_ENABLED=false
IDENTITY_PLATFORM_PROJECT=
IDENTITY_WEB_API_KEY=
IDENTITY_TENANT_MAP_JSON={}
# Optional browser override:
# NEXT_PUBLIC_IDENTITY_API_KEY=

# Set after GCP project approval
GOOGLE_CLOUD_PROJECT=
GCP_REGION=asia-south1
GCS_BUCKET=
GCS_RAW_BUCKET=
GCS_IMAGE_BUCKET=
EXTRACTION_URL=
SIMILARITY_URL=
DATABASE_URL=
CLOUD_SQL_INSTANCE=
BQ_PROJECT=
# Command Center reads customers/orders/commodities/login_cred_db from this dataset
USE_BQ=true
BQ_DATASET=suffai_ops
BQ_MARTS_DATASET=suffai_marts
USE_BIGQUERY_MARTS=false
MONGO_URI=
ENABLE_VERTEX=false
VERTEX_LOCATION=asia-south1
VERTEX_CHAT_MODEL=gemini-2.5-flash
# 1P platform fee cold-start policy. These price SuffAI's service separately from media spend.
FEE_MODEL_VERSION=cost_model_v1
FEE_BASE_INR=1500
FEE_PER_1K_AUDIENCE=35
FEE_PER_SKU_INR=125
FEE_PER_PIN_INR=45
FEE_PER_10K_COMPARISONS_INR=20
FEE_PER_PROCESS_MINUTE_INR=12
FEE_PER_EXTRA_CHANNEL_INR=250
FEE_PER_DAY_INR=10
FEE_MIN_INR=1500
FEE_MAX_PCT_OF_BUDGET=0.35
# Keep false until 500–1,000 real accepted/final-fee labels exist. Shadow predictions never serve prices.
FEE_VERTEX_SHADOW=false
VERTEX_FEE_ENDPOINT_ID=
# Geo 4 km store guardrail (Gemini + Google Search grounding, billed per grounded prompt)
GEO_GROUNDING_ENABLED=true
GEO_GROUNDING_MODEL=gemini-2.5-flash
GEO_GROUNDING_LOCATION=global
GEO_CITY=Bengaluru
GEO_STORE_CACHE_DAYS=7
GEO_MARKET_CACHE_DAYS=7
# Admin intelligence tabs: seconds to cache the BigQuery customers/orders/commodities load
ADMIN_INTEL_CACHE_SEC=600
# Seconds between BigQuery table last-modified checks; a change (extraction, similarity, loads)
# clears the metrics and Admin caches. 0 turns it off.
BQ_FRESHNESS_SEC=30
# Most customers personalised per campaign (BigQuery audience x Cloud SQL wardrobes)
CAMPAIGN_ELIGIBLE_USER_CAP=200
GEO_PERSONA_MIN_CUSTOMERS=3
ENABLE_ADV=true
PRIVACY_DIFFERENCING_ENABLED=true
PRIVACY_K=30
EXPORT_REQUIRE_ROLE=brand_analyst
MEDIA_ACTIVATION_WEBHOOK=
PUBSUB_IMAGE_TOPIC=garment-image-uploaded
# suffai-extraction publishes here after a customer photo and its warehouse SKU match are saved; similarity subscribes
PUBSUB_EXTRACTED_TOPIC=garment-image-extracted
PUBSUB_SIMILARITY_SUBSCRIPTION=garment-image-extracted-similarity-push
# Campaign jobs on Cloud Tasks (optional). Set by deploy/setup_cloud_tasks.sh; leave empty to run
# jobs in a background thread inside Command Center (fine for a single instance).
COMMAND_CENTER_URL=
CLOUD_TASKS_QUEUE=
TASKS_SERVICE_ACCOUNT=
